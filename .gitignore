# Генерируемое в проектах (пересобирается из project.yaml + script/ + templates/)
projects/*/build/
projects/*/qa/
# `python -m studio demo <slug>` → projects/<slug>-demo/, регресс → projects/regress*/
projects/*-demo/
projects/regress*/
# то же в студиях (ROADMAP A1): studios/<id>/projects/<slug>/
studios/*/projects/*/build/
studios/*/projects/*/qa/
studios/*/projects/*-demo/
logs/
*.log
output/

# Секреты (ключ ElevenLabs и т.п.)
.env
.env.*
!.env.example

# Внешние бинарники и голоса (ставятся tools/setup_rhvoice.sh)
tools/rhvoice/
tools/.build/
tools/piper-voices/
# Вырезание фона для слоёв картинок (ROADMAP C5): свой venv, чтобы не трогать Pillow студии
tools/rembg-venv/

# Claude Code: локальное
.claude/settings.local.json
.claude/worktrees/
.channel-kit-incoming/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
venv/
tests/.golden-diff/

# IDE / ОС
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
