# Скопируйте в .env (он в .gitignore) и впишите значения. Никогда не коммитьте .env.
# Свой ключ и голос у студии-клиента — studios/<id>/.env (те же имена); этот корневой .env — запасной (docs/TTS.md).
# ElevenLabs — голос канала Notes From The Mind (tts.backend: elevenlabs в project.yaml)
ELEVENLABS_API_KEY=
# ID голоса: elevenlabs.io → Voices → ваш голос → «ID» (строка вида 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=
# Модель (необязательно): eleven_multilingual_v2 — по умолчанию
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Kie AI — генерация картинок для сцен (images.backend: kie в project.yaml, ROADMAP C5). Ключ: kie.ai → API Key
KIE_API_KEY=
